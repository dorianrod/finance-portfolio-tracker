#!/usr/bin/env bash
# Blocks committing staged changes (code, comments, test fixtures, ...)
# that mention a personal portfolio ticker/ISIN (see scan_personal_data.py).
# Bypass with `git commit --no-verify`.
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
python="$repo_root/packages/pipeline/.venv/bin/python"
[ -x "$python" ] || python="python3"

git diff --cached | "$python" "$repo_root/.githooks/scan_personal_data.py"
