#!/usr/bin/env bash
# Blocks committing with a message that mentions a personal portfolio
# ticker/ISIN (see scan_personal_data.py). Bypass with `git commit --no-verify`.
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
python="$repo_root/packages/pipeline/.venv/bin/python"
[ -x "$python" ] || python="python3"

"$python" "$repo_root/.githooks/scan_personal_data.py" < "$1"
