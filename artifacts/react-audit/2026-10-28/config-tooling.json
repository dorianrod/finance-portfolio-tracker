{
  "languageOptions": {
    "parserOptions": {
      "sourceType": "module"
    }
  },
  "rules": {
    "local/require-reviewed-eslint-suppression": [
      2
    ],
    "local/reviewed-eslint-suppression": [
      1
    ],
    "local/no-conditional-test-assertions": [
      2
    ],
    "local/no-test-style-assertions": [
      2
    ],
    "local/prefer-semantic-test-queries": [
      2
    ],
    "local/test-fixture-contract": [
      2
    ],
    "simple-import-sort/exports": [
      2
    ],
    "simple-import-sort/imports": [
      2
    ]
  }
}
