{
  "name": "dashboard",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "storybook": "storybook dev --port 6006 --config-dir src/shared/ui/storybook --no-open",
    "build-storybook": "storybook build --config-dir src/shared/ui/storybook --output-dir storybook-static",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "format": "prettier --write . && npm run lint -- --fix && prettier --write .",
    "format:check": "prettier --check . && npm run lint",
    "lint": "react-best-practices-lint --max-warnings 1",
    "lint:counts": "react-best-practices-lint-counts",
    "lint:profile": "react-best-practices-profile",
    "audit:i18n": "eslint src --quiet && react-best-practices-i18n --catalog src/i18n/locales/en.json",
    "typecheck": "tsc -b --pretty false",
    "preview": "vite preview",
    "test": "vitest run && npm run test:skill",
    "audit:architecture": "react-best-practices-architecture",
    "audit:cycles": "react-best-practices-cycles --project tsconfig.app.json",
    "audit:colocation": "react-best-practices-test-colocation",
    "audit:metrics": "react-best-practices-audit-metrics",
    "test:skill": "vitest run --config node_modules/@frontend-engineering/react-best-practices/vitest.config.mjs",
    "audit:fixtures": "react-best-practices-fixtures --project tsconfig.fixtures.json",
    "audit:fixtures:check": "react-best-practices-fixtures --project tsconfig.fixtures.json --review tests/fixtures/ownership-review.json"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.14.19",
    "@types/papaparse": "^5.5.2",
    "i18next": "^26.5.6",
    "jotai": "^2.20.3",
    "jotai-scope": "^0.12.2",
    "papaparse": "^5.5.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-i18next": "^17.1.4",
    "recharts": "^3.10.1",
    "tailwindcss": "^4.3.0",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@frontend-engineering/react-best-practices": "file:../../.agents/skills/generic-react-best-practices",
    "@storybook/addon-docs": "10.6.3",
    "@storybook/addon-themes": "10.6.3",
    "@storybook/react-vite": "10.6.3",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "prettier": "3.9.10",
    "storybook": "10.6.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.3.5",
    "vitest": "^4.1.9"
  }
}
