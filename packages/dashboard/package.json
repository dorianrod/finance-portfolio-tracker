{
  "name": "dashboard",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "format": "prettier --write . && eslint . --fix && prettier --write .",
    "format:check": "prettier --check . && eslint .",
    "lint": "eslint .",
    "audit:i18n": "eslint src --quiet && node scripts/check-i18n-catalog.mjs",
    "typecheck": "tsc -b --pretty false",
    "preview": "vite preview",
    "test": "vitest run"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.14.19",
    "@types/papaparse": "^5.5.2",
    "i18next": "^26.5.6",
    "jotai": "^2.20.3",
    "papaparse": "^5.5.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-i18next": "^17.1.4",
    "recharts": "^3.10.1",
    "tailwindcss": "^4.3.0",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "prettier": "3.9.10",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.3.5",
    "vitest": "^4.1.9"
  }
}
